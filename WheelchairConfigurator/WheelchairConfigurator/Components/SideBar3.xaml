<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Components.SideBar3">

    <Border BackgroundColor="#F8F8F8" StrokeThickness="0" WidthRequest="250">
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Vozík" FontAttributes="Bold" FontSize="18" />

            <Label Text="Ovládání rukou"></Label>
            <Picker x:Name="handControlEntry" Title="Vyberte" SelectedIndexChanged="OnHandControlChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Ano</x:String>
                        <x:String>Ne</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Terén a prostředí"></Label>
            <Picker x:Name="enviromentEntry" Title="Vyberte" SelectedIndexChanged="OnEnvironmentChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Indoor</x:String>
                        <x:String>Outdoor</x:String>
                        <x:String>Kombinace</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

        </VerticalStackLayout>
    </Border>
</ContentView>