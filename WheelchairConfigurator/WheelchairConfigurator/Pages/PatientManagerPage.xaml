<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Pages.PatientManagerPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="16">

        <Label Grid.Row="0" Text="Správa pacientů"
               FontSize="22" FontAttributes="Bold" />

        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="20">

            <!-- Levý sloupec: seznam pacientů -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10">
                <Label Grid.Row="0" Text="Pacienti" FontSize="16" FontAttributes="Bold" />

                <CollectionView Grid.Row="1"
                                x:Name="PatientList"
                                SelectionMode="Single"
                                SelectionChanged="OnPatientSelected">
                    <CollectionView.EmptyView>
                        <Label Text="Žádní pacienti" TextColor="Gray"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding BirthNumber}" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding FullName}" FontSize="13" />
                                    <Label Text="{Binding CreatedAt, StringFormat='Přidán: {0:dd.MM.yyyy}'}"
                                           FontSize="11" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="2" x:Name="DeactivatePatientBtn"
                        Text="Deaktivovat pacienta"
                        Clicked="OnDeactivatePatientClicked"
                        BackgroundColor="OrangeRed"
                        IsEnabled="False" />
            </Grid>

            <!-- Pravý sloupec: záznamy měření + formulář nového pacienta -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, *, Auto" RowSpacing="10">
                <Label Grid.Row="0" x:Name="RightPanelTitle" Text="Vyberte pacienta"
                       FontSize="16" FontAttributes="Bold" />

                <!-- Formulář nového pacienta (zobrazen při nezvolení) -->
                <Grid Grid.Row="1" x:Name="NewPatientForm" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <Label Grid.Row="0" Text="Přidat nového pacienta" FontSize="13" TextColor="Gray" />
                    <Entry Grid.Row="1" x:Name="BirthNumberEntry" Placeholder="Rodné číslo" MaxLength="20" />
                    <Entry Grid.Row="2" x:Name="FirstNameEntry" Placeholder="Jméno" />
                    <Entry Grid.Row="3" x:Name="LastNameEntry" Placeholder="Příjmení" />
                </Grid>

                <!-- Záznamy měření (zobrazeny po výběru pacienta) -->
                <CollectionView Grid.Row="2"
                                x:Name="MeasurementList"
                                SelectionMode="Single"
                                SelectionChanged="OnMeasurementSelected"
                                IsVisible="False">
                    <CollectionView.EmptyView>
                        <Label Text="Žádná měření" TextColor="Gray"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding MeasuredAt, StringFormat='Datum: {0:dd.MM.yyyy HH:mm}'}"
                                           FontAttributes="Bold" FontSize="13" />
                                    <Label Text="{Binding CreatedBySpecialistName, StringFormat='Terapeut: {0}'}"
                                           FontSize="12" TextColor="Gray" />
                                    <Label Text="{Binding BodyHeight, StringFormat='Výška trupu: {0} cm'}"
                                           FontSize="12" />
                                    <Label Text="{Binding Weight, StringFormat='Hmotnost: {0} kg'}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Grid.Row="3" x:Name="ActionBtn"
                        Text="Přidat pacienta"
                        Clicked="OnActionClicked"
                        HorizontalOptions="Fill" />
            </Grid>

        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*" >
            <Button Text="Zpět" BackgroundColor="Red"
                    Clicked="OnBackClicked" HorizontalOptions="Fill" />
        </Grid>

    </Grid>
</ContentPage>
