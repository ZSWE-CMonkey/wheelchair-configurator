<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Pages.ComponentManagerPage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*, Auto" Padding="20" RowSpacing="15">

        <Grid Grid.Row="0" ColumnDefinitions="*, 2*" ColumnSpacing="20">

            <!-- Component addition -->
            <Border Grid.Column="0"
                    Padding="20"
                    StrokeThickness="1"
                    Stroke="#E0E0E0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Přidat komponentu"
                           FontAttributes="Bold"
                           FontSize="20"
                           Margin="0,0,0,8" />

                    <Label Text="Kategorie" FontSize="13" />
                    <Picker x:Name="CategoryPicker"
                            Title="Vyberte kategorii"
                            HorizontalOptions="Fill" />

                    <Label Text="Název" FontSize="13" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Zadejte název"
                           HorizontalOptions="Fill" />

                    <Label Text="Popis" FontSize="13" />
                    <Editor x:Name="DescriptionEditor"
                        Placeholder="Zadejte popis"
                        HeightRequest="60"
                        HorizontalOptions="Fill" />

                    <Button Text="Přidat"
                            Clicked="OnAddComponentClicked"
                            HorizontalOptions="Fill"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Component removal -->
            <Border Grid.Column="1"
            Padding="20"
            StrokeThickness="1"
            Stroke="#E0E0E0">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                    <!-- Categories list -->
                    <Grid Grid.Column="0" RowDefinitions="Auto, *">
                        <Label Grid.Row="0"
                   Text="Odstranit komponentu"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,0,0,10" />
                        <CollectionView Grid.Row="1"
                            x:Name="CategoryList"
                            SelectionMode="Single"
                            SelectionChanged="OnCategorySelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                Padding="12"
                                StrokeThickness="1"
                                Stroke="#E0E0E0">
                                        <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>

                    <!-- Components list -->
                    <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
                        <Label Grid.Row="0"
                   x:Name="ComponentListTitle"
                   Text="Vyberte kategorii"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="0,0,0,10" />
                        <CollectionView Grid.Row="1"
                            x:Name="ComponentList"
                            SelectionMode="Single"
                            SelectionChanged="OnComponentSelected">
                            <CollectionView.EmptyView>
                                <Label Text="Žádné komponenty"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                Padding="12"
                                StrokeThickness="1"
                                Stroke="#E0E0E0">
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                            <Label Text="{Binding Description}"
                                       FontSize="12"
                                       TextColor="Gray" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Grid.Row="2"
                    x:Name="RemoveBtn"
                    Text="Odstranit"
                    Clicked="OnRemoveComponentClicked"
                    IsEnabled="False"
                    BackgroundColor="Red"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    Margin="0,10,0,0" />
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <!-- Back button -->
        <Button Grid.Row="1"
                Text="Zpět"
                Clicked="OnBackClicked"
                HorizontalOptions="Start"
                WidthRequest="150" />

    </Grid>
</ContentPage>