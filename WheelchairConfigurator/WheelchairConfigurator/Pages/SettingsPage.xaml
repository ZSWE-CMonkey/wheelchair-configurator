<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Pages.SettingsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="16">

        <Label Grid.Row="0" Text="Nastavení"
               FontSize="22" FontAttributes="Bold" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20">

                <!-- 3D náhled -->
                <Border Padding="16" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="3D náhled vozíku" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Vypnutím se ušetří výpočetní výkon"
                                   FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="RenderingSwitch"
                                VerticalOptions="Center"
                                Toggled="OnRenderingToggled" />
                    </Grid>
                </Border>

                <!-- Vysoká kvalita textur -->
                <Border Padding="16" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Text="Vysoká kvalita textur (mipmaps + anisotropy 4×)" FontSize="15" FontAttributes="Bold" />
                            <Label Text="Ostřejší textury pod úhlem a při vzdálení. Změna se projeví po restartu aplikace."
                                   FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" x:Name="HighQualityTexturesSwitch"
                                VerticalOptions="Center"
                                Toggled="OnHighQualityTexturesToggled" />
                    </Grid>
                </Border>

                <!-- Export katalogu -->
                <Border Padding="16" StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Katalog komponent" FontSize="15" FontAttributes="Bold" />
                        <Button Text="Exportovat katalog (JSON)"
                                Clicked="OnExportCatalogClicked"
                                HorizontalOptions="Fill" />
                        <Button Text="Importovat katalog (JSON)"
                                Clicked="OnImportCatalogClicked"
                                HorizontalOptions="Fill" />
                        <Label x:Name="CatalogStatusLabel" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <!-- Vývojářské nástroje -->
                <Border Padding="16" StrokeThickness="2"
                        Stroke="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Vývojářské nástroje" FontSize="15" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
                        <Label Text="Načtení testovacích dat: dropne tabulky a načte seed_data.json (komponenty + testovací terapeut + testovací pacient)."
                               FontSize="12" TextColor="Gray" />
                        <Button x:Name="LoadTestDataBtn" Text="Načíst testovací data"
                                BackgroundColor="#2E7D32" TextColor="White"
                                Clicked="OnLoadTestDataClicked"
                                HorizontalOptions="Fill" />
                        <Label Text="Vymazání databáze: dropne tabulky a nechá prázdné schéma. SMAŽE veškerá data včetně katalogu."
                               FontSize="12" TextColor="Gray" />
                        <Button x:Name="WipeDbBtn" Text="Vymazat databázi"
                                BackgroundColor="#D32F2F" TextColor="White"
                                Clicked="OnWipeDbClicked"
                                HorizontalOptions="Fill" />
                        <Label x:Name="DevStatusLabel" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" Text="Zpět" BackgroundColor="Red"
                Clicked="OnBackClicked" HorizontalOptions="Fill" />

    </Grid>
</ContentPage>
