<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Pages.ConfiguratorPage1"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="350, *" RowDefinitions="*, Auto">

        <!-- SidePanel -->
        <ContentView x:Name="SidebarContainer" 
                     Grid.Column="0" 
                     Grid.Row="0"
                     BackgroundColor="#F5F5F5" />

        <!-- Preview -->
        <VerticalStackLayout Grid.Column="1" Grid.Row="0" VerticalOptions="Center" Grid.RowSpan="2" HorizontalOptions="Center">
            <Image Source="mainpage.webp" HeightRequest="300" />
            <Label Text="Zde se zobrazí tvůj vozík" FontSize="20" />
        </VerticalStackLayout>

        <!-- Navigation buttons -->
        <HorizontalStackLayout Grid.Column="0" 
                               Grid.Row="1" 
                               Spacing="10" 
                               Padding="20" 
                               HorizontalOptions="Center">
            <Button Text="Zpět" Clicked="OnBackClicked" x:Name="BackBtn" />
            <Button Text="Další" Clicked="OnNextClicked" x:Name="NextBtn" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>