<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WheelchairConfigurator.Pages.TherapistManagerPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="16">

        <!-- Nadpis -->
        <Label Grid.Row="0"
               Text="Správa terapeutů"
               FontSize="22"
               FontAttributes="Bold" />

        <!-- Obsah -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="20">

            <!-- Seznam terapeutů -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *" RowSpacing="10">
                <Label Grid.Row="0" Text="Terapeuti" FontSize="16" FontAttributes="Bold" />
                <CollectionView Grid.Row="1"
                                x:Name="TherapistList"
                                SelectionMode="Single"
                                SelectionChanged="OnTherapistSelected">
                    <CollectionView.EmptyView>
                        <Label Text="Žádní terapeuti" TextColor="Gray"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3D3D3D}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding Clinic}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Email}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="✓" FontSize="18" TextColor="Green"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsSelected}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Formulář přidání/editace -->
            <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" RowSpacing="10">
                <Label Grid.Row="0" x:Name="FormTitle" Text="Přidat terapeuta"
                       FontSize="16" FontAttributes="Bold" />

                <Entry Grid.Row="1" x:Name="FirstNameEntry" Placeholder="Jméno" />
                <Entry Grid.Row="2" x:Name="LastNameEntry" Placeholder="Příjmení" />
                <Entry Grid.Row="3" x:Name="EmailEntry" Placeholder="Email (volitelně)" Keyboard="Email" />
                <Entry Grid.Row="4" x:Name="ClinicEntry" Placeholder="Klinika (volitelně)" />

                <Grid Grid.Row="5" ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Button Grid.Column="0" x:Name="SaveFormBtn" Text="Uložit"
                            Clicked="OnSaveFormClicked" HorizontalOptions="Fill" />
                    <Button Grid.Column="1" x:Name="ClearFormBtn" Text="Vymazat"
                            Clicked="OnClearFormClicked" HorizontalOptions="Fill"
                            BackgroundColor="Gray" />
                </Grid>

                <Button Grid.Row="6" x:Name="DeactivateBtn" Text="Deaktivovat vybraného"
                        Clicked="OnDeactivateClicked"
                        BackgroundColor="OrangeRed"
                        IsEnabled="False"
                        VerticalOptions="End" />
            </Grid>

        </Grid>

        <!-- Tlačítka dole -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
            <Button Grid.Column="0" Text="Zpět" BackgroundColor="Red"
                    Clicked="OnBackClicked" HorizontalOptions="Fill" />
            <Button Grid.Column="1" x:Name="SelectBtn" Text="Nastavit jako aktivního"
                    Clicked="OnSelectClicked"
                    IsEnabled="False"
                    HorizontalOptions="Fill" />
        </Grid>

    </Grid>
</ContentPage>
