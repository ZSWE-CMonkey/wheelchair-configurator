<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WheelchairConfigurator.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WheelchairConfigurator"
    xmlns:pages="clr-namespace:WheelchairConfigurator.Pages"
    Shell.FlyoutBehavior="Disabled"
    Title="WheelchairConfigurator">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="MainPage" />

</Shell>
